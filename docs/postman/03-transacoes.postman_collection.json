            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeCategoria}}\",\n  \"tipoPadrao\": \"DESPESA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"nomeCategoria\", \"Categoria \" + Math.floor(Math.random() * 1000000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"idCategoria\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
