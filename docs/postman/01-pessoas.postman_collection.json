  },
  "item": [
    {
      "name": "1 - Usuários",
      "item": [
        {
          "name": "Cadastrar usuário (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pessoas/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Gustavo Teste\",\n  \"cpf\": \"{{cpf}}\",\n  \"email\": \"gustavo.teste@email.com\",\n  \"telefone\": \"11987654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// gera um CPF aleatorio de 11 digitos para poder rodar a collection varias vezes",
                  "let cpf = \"\"; for (let i = 0; i < 11; i++) { cpf += Math.floor(Math.random() * 10); }",
                  "pm.collectionVariables.set(\"cpf\", cpf);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"idUsuario\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
