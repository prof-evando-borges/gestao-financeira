{
  "info": {
    "name": "07 - Educação Financeira",
    "description": "Módulo 07 (Grupo 1) - /api/v1/educacao. Rode as pastas em ordem (0 a 3): os ids criados ficam salvos nas variáveis da collection. Precisa do módulo 01 (Pessoas) para criar o usuário de teste.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Preparação (módulo 01 - Pessoas)",
      "item": [
        {
          "name": "Cadastrar usuário de teste (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pessoas/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno Educação Teste\",\n  \"cpf\": \"{{cpf}}\",\n  \"email\": \"aluno.educacao@email.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// CPF aleatorio de 11 digitos para poder rodar a collection varias vezes",
                  "let cpf = \"\"; for (let i = 0; i < 11; i++) { cpf += Math.floor(Math.random() * 10); }",
                  "pm.collectionVariables.set(\"cpf\", cpf);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"idUsuario\", pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
