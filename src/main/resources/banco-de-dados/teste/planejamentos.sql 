-- Tabela referenciada primeiro: META
CREATE TABLE TB_PLN_META (
    ID              VARCHAR2(36)   NOT NULL,
    ID_USUARIO      VARCHAR2(36)   NOT NULL,
    NOME            VARCHAR2(100)  NOT NULL,
    VALOR_OBJETIVO  NUMBER(15,2)   NOT NULL,
    DATA_CRIACAO    DATE           NOT NULL,
    DATA_LIMITE     DATE           NOT NULL,
    CONSTRAINT PK_PLN_META PRIMARY KEY (ID),
    CONSTRAINT FK_PLN_META_USUARIO FOREIGN KEY (ID_USUARIO) REFERENCES TB_USUARIO (ID),
    CONSTRAINT CK_PLN_META_VALOR_OBJETIVO CHECK (VALOR_OBJETIVO > 0),
    CONSTRAINT CK_PLN_META_DATA_LIMITE CHECK (DATA_LIMITE >= DATA_CRIACAO)
);

-- Tabela que referencia META: APORTE
CREATE TABLE TB_PLN_APORTE (
    ID           VARCHAR2(36)  NOT NULL,
    ID_META      VARCHAR2(36)  NOT NULL,
    VALOR        NUMBER(15,2)  NOT NULL,
    DATA_APORTE  DATE          NOT NULL,
    CONSTRAINT PK_PLN_APORTE PRIMARY KEY (ID),
    CONSTRAINT FK_PLN_APORTE_META FOREIGN KEY (ID_META) REFERENCES TB_PLN_META (ID),
    CONSTRAINT CK_PLN_APORTE_VALOR CHECK (VALOR > 0)
);